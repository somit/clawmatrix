{
  "models": {
    "mode": "merge",
    "providers": {
      "cloudflare-workers-ai": {
        "baseUrl": "https://api.cloudflare.com/client/v4/accounts/__CLOUDFLARE_ACCOUNT_ID__/ai/v1",
        "api": "openai-completions",
        "apiKey": "__CLOUDFLARE_API_KEY__",
        "authHeader": true,
        "models": [
          {
            "id": "@cf/mistralai/mistral-small-3.1-24b-instruct",
            "name": "Cloudflare Mistral Small 3.1 24B Instruct",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0.351, "output": 0.555 },
            "contextWindow": 128000,
            "maxTokens": 2048,
            "compat": {
              "supportsTools": false,
              "supportsStrictMode": false,
              "supportsPromptCacheKey": false,
              "supportsStore": false
            }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "models": {
        "cloudflare-workers-ai/@cf/mistralai/mistral-small-3.1-24b-instruct": {}
      },
      "model": { "primary": "cloudflare-workers-ai/@cf/mistralai/mistral-small-3.1-24b-instruct" },
      "compaction": { "mode": "safeguard" },
      "maxConcurrent": 2,
      "subagents": { "maxConcurrent": 4 },
      "heartbeat": { "every": "0m" }
    },
    "list": [
      {
        "id": "cto-id",
        "name": "cto",
        "default": true,
        "workspace": "/workspace/cto",
        "identity": { "name": "CTO", "theme": "Tech leadership" },
        "subagents": { "allowAgents": ["techlead"] }
      },
      {
        "id": "techlead-id",
        "name": "techlead",
        "workspace": "/workspace/techlead",
        "identity": { "name": "Tech Lead", "theme": "Senior engineering specialist" }
      }
    ]
  },
  "tools": {
    "agentToAgent": {
      "enabled": true,
      "allow": ["cto-id", "techlead-id"]
    },
    "web": {
      "fetch": { "enabled": true },
      "search": { "enabled": false }
    }
  },
  "browser": {
    "noSandbox": true,
    "executablePath": "/usr/bin/chromium-browser"
  },
  "channels": {},
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": { "mode": "none" }
  }
}
